{
  "schema": 1,
  "id": "abando/facade-store",
  "version": 2,
  "name": "Store fa\u00e7ade",
  "kind": "pattern",
  "tags": ["facade", "store", "industrial"],
  "author": "OpenBando",
  "licence": "CC-BY-4.0",
  "description": "Bays of two lower panels and one full-height door, repeated along the chosen walls of the floor.",
  "thumbnail": "icon:door",
  "params": [
    {
      "key": "bay",
      "label": "Bay",
      "type": "number",
      "default": 5,
      "min": 2,
      "max": 20,
      "step": 0.5
    },
    {
      "key": "side",
      "label": "Walls",
      "type": "choice",
      "options": ["all", "n", "s", "e", "w"],
      "default": "all"
    }
  ],
  "content": {
    "pattern": {
      "facade": {
        "pattern": "store",
        "bay": {
          "$": "bay"
        },
        "side": {
          "$": "side"
        }
      }
    }
  }
}
