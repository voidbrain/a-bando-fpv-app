{
  "schema": 1,
  "id": "abando/main-store",
  "version": 2,
  "name": "Main store shell",
  "kind": "pattern",
  "tags": [
    "store",
    "preset",
    "industrial"
  ],
  "author": "A Bando",
  "licence": "CC-BY-4.0",
  "description": "Long walls 2 panels + 1 door, one end all doors, the other all panels, and four rows of columns: a quarter in from each long wall and a pair in the middle, on the piers.",
  "thumbnail": "icon:building",
  "params": [
    {
      "key": "bay",
      "label": "Bay",
      "type": "number",
      "default": 5,
      "min": 2,
      "max": 20,
      "step": 0.5
    },
    {
      "key": "rows",
      "label": "Column rows",
      "type": "int",
      "default": 4,
      "min": 1,
      "max": 8
    },
    {
      "key": "step",
      "label": "Columns every (0 = every third pier)",
      "type": "number",
      "default": 0,
      "min": 0,
      "max": 40,
      "step": 0.5
    }
  ],
  "content": {
    "pattern": {
      "store": {
        "bay": {
          "$": "bay"
        },
        "step": {
          "$": "step"
        },
        "rows": {
          "$": "rows"
        },
        "inset": 4
      }
    }
  }
}
