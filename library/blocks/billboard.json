            "mul": -0.3
          },
          "y": 0,
          "z": 0.3
        },
        "radius": 0.2,
        "height": {
          "$": "h",
          "mul": 1,
          "add": 3
        },
        "color": "#5a5f62"
      },
      {
        "prim": "cylinder",
        "at": {
          "x": {
            "$": "w",
            "mul": 0.3
          },
          "y": 0,
          "z": 0.3
        },
        "radius": 0.2,
        "height": {
          "$": "h",
          "mul": 1,
          "add": 3
        },
        "color": "#5a5f62"
      },
      {
        "prim": "box",
        "at": {
          "x": 0,
          "y": {
            "$": "h",
            "mul": 1,
            "add": 1.5
          },
          "z": 0
        },
        "size": {
          "x": {
            "$": "w"
          },
          "y": 3,
          "z": 0.25
        },
        "color": "#d9d2b6"
